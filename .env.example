# =============================================================================
# Delta Journal - Essential Configuration
# =============================================================================
# Copy this file to .env and fill in your actual values.

# === DELTA EXCHANGE API (READ-ONLY) ===
# Get your READ-ONLY API keys from: https://www.delta.exchange/app/account/api
DELTA_API_KEY=your_read_only_key
DELTA_API_SECRET=your_read_only_secret

# Region: "india" (api.india.delta.exchange) or "global" (api.delta.exchange)
DELTA_REGION=india

# === AI COACH & MARKET DATA ===
# Provider: "vertex" (Google Vertex AI) or "ollama" (local Ollama instance)
AI_PROVIDER=ollama

# Google Cloud project ID (required for Vertex AI)
PROJECT_ID=your_gcp_project_id

# Ollama base URL (required when AI_PROVIDER=ollama)
# OLLAMA_BASE_URL=http://localhost:11434

# Ollama model name to use (required when AI_PROVIDER=ollama)
# OLLAMA_MODEL=llama3.2

# === NOTIFICATIONS (Optional) ===
# Webhook URL for P&L alerts (Discord/Slack/Telegram)
WEBHOOK_URL=
PNL_ALERT_THRESHOLD=100.0

# === STATIC IP PROXY (Optional) ===
# Route all outbound Delta Exchange API calls through a static proxy (e.g. for API key IP whitelisting).
# If you are running under dynamic Host IPs, uncomment the compiled strings below to enable the proxy.
PROXY_USER=proxyuser
PROXY_PASS=proxypass123
PROXY_IP=185.230.124.5
PROXY_PORT=8080

# Uncomment the compiled proxy connections to activate them in Docker Compose:
# HTTP_PROXY=http://proxyuser:proxypass123@185.230.124.5:8080
# HTTPS_PROXY=http://proxyuser:proxypass123@185.230.124.5:8080
